# Supabase (project: pulse-crm, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://gwdjwmoiyoklknuicuax.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app (used in auth redirects and invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (sending domain nitzanet.co.il is already verified)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Pulse CRM <crm@nitzanet.co.il>"

# Shared secret for the daily reminders job (Vercel Cron sends it as a Bearer token;
# its sha256 is stored in Supabase private.app_settings.cron_secret_sha256)
CRON_SECRET=xxx

# Booking notifications (/api/cron/notifications, daily). With a once-a-day cron,
# 12 sends each "24h before" reminder 12-36h ahead; set 0 with a frequent cron.
NOTIFY_LOOKAHEAD_HOURS=12

# WhatsApp Business Cloud API (Meta). Without these, WhatsApp runs in simulation.
# Business-initiated messages need approved templates; body params: name, service, date, time, address.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANG=he

# Google Calendar sync (schema ready; OAuth flow not wired yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
